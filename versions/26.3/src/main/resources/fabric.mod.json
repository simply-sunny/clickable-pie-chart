{
	"schemaVersion": 1,
	"id": "clickablepiechart",
	"version": "${version}",
	"name": "Clickable Pie Chart",
	"description": "Mouse navigation for the F3 profiler pie chart: hold Shift to free the cursor, click entries or slices to drill in, right-click to go back.",
	"authors": [
		"simply-sunny"
	],
	"contact": {
		"sources": "https://github.com/simply-sunny/clickable-pie-chart",
		"issues": "https://github.com/simply-sunny/clickable-pie-chart/issues"
	},
	"license": "MIT",
	"environment": "client",
	"entrypoints": {
		"client": [
			"com.helper.clickablepiechart.ClickablePieChartClient"
		]
	},
	"mixins": [
		"clickablepiechart.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.16.14",
		"minecraft": "26.3",
		"java": ">=25",
		"fabric-api": "*"
	}
}
